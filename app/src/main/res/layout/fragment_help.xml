<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/midnight_blue"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Faculty 1 Info -->
    <TextView
        android:id="@+id/faculty1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Faculty 1"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:layout_marginStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Faculty 1 Email -->
    <ImageView
        android:id="@+id/email_icon1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/email_icon"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toBottomOf="@id/faculty1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/email1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email: faculty1@example.com"
        android:textColor="@color/blue"
        android:clickable="true"
        android:background="?attr/selectableItemBackground"
    app:layout_constraintTop_toBottomOf="@id/faculty1"
    app:layout_constraintStart_toEndOf="@id/email_icon1"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp" />

    <!-- Faculty 1 Contact -->
    <ImageView
        android:id="@+id/contact_icon1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/phone_icon"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toBottomOf="@id/email1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/contact1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact: +911234567890"
        android:textColor="@color/blue"
        android:clickable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/email1"
        app:layout_constraintStart_toEndOf="@id/contact_icon1"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp" />

    <!-- Faculty 1 Address -->
    <ImageView
        android:id="@+id/address_icon1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:src="@drawable/ic_location_pin1"
        app:layout_constraintTop_toBottomOf="@id/contact1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/address1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Address: Office 1, Building A"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/contact1"
        app:layout_constraintStart_toEndOf="@id/address_icon1"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp" />

    <!-- Faculty 2 Info -->
    <TextView
        android:id="@+id/faculty2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Faculty 2"
        android:textStyle="bold"
        android:layout_marginStart="15dp"
        android:textSize="18sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/address1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Faculty 2 Email -->
    <ImageView
        android:id="@+id/email_icon2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/email_icon"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toBottomOf="@id/faculty2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/email2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email: faculty2@example.com"
        android:textColor="@color/blue"
        android:clickable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/faculty2"
        app:layout_constraintStart_toEndOf="@id/email_icon2"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp" />

    <!-- Faculty 2 Contact -->
    <ImageView
        android:id="@+id/contact_icon2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/phone_icon"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toBottomOf="@id/email2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/contact2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact: +911234567890"
        android:textColor="@color/blue"
        android:clickable="true"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/email2"
        app:layout_constraintStart_toEndOf="@id/contact_icon2"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp" />

    <!-- Faculty 1 Address -->
    <ImageView
        android:id="@+id/address_icon2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_location_pin1"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toBottomOf="@id/contact2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/address2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Address: Office 1, Building A"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/contact2"
        app:layout_constraintStart_toEndOf="@id/address_icon2"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp" />
</androidx.constraintlayout.widget.ConstraintLayout>